# Copy this file to `.env` in the same folder (backend/) and fill in your real values.
# NEVER commit the real .env file -- it's already covered by .gitignore.

# A long random string used to sign JWT tokens. This one was randomly generated for you --
# it's safe to use as-is, or generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=480938a6776e83344a46c6bcde9602612ba1c6014d0d331b46fbbbcb37098f94

# Gmail SMTP credentials for sending password reset emails.
# SMTP_USER is your full Gmail address.
# SMTP_PASSWORD must be a 16-character Gmail "App Password" -- NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account first)
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your16charapppassword

# Where your frontend runs -- used to build the link inside password reset emails
FRONTEND_URL=http://localhost:3000
