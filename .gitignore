# Python
backend/venv/
__pycache__/
*.pyc
*.pyo

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# YOLO model weights (auto-downloaded on first run, no need to commit ~6MB+ files)
*.pt

