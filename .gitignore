backend/uploaded_videos/
backend/uploaded_avatars/
backend/runs/
backend/*.mp4
backend/*.jpg

# Backend secrets (SECRET_KEY, SMTP credentials -- never commit real values)
backend/.env

# Database (generated at runtime, not source code)
database/*.db
database/traffic_analyzer.db

# Temporary inspection zips (not part of the project)
backend_source.zip
frontend_source.zip

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/